{
  "name": "frontend",
  "version": "0.0.0",
  "description": "CRM Lite frontend — Angular SPA behind the api-gateway BFF. See FRONTEND_BRAIN.md.",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "check:conventions": "node scripts/check-conventions.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\""
  },
  "dependencies": {
    "@angular/common": "22.0.8",
    "@angular/compiler": "22.0.8",
    "@angular/core": "22.0.8",
    "@angular/forms": "22.0.8",
    "@angular/platform-browser": "22.0.8",
    "@angular/router": "22.0.8",
    "@fontsource-variable/inter": "5.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.0.8",
    "@angular/cli": "22.0.8",
    "@angular/compiler-cli": "22.0.8",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "angular-eslint": "22.1.0",
    "eslint": "10.7.0",
    "jsdom": "28.1.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vitest": "4.1.10"
  }
}
