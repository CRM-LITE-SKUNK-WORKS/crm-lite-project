{
  "realm": "crm-lite",
  "enabled": true,
  "displayName": "CRM Lite",
  "loginTheme": "crm-lite",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "tr"],
  "defaultLocale": "en",

  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 86400,
  "accessTokenLifespan": 300,
  "clientSessionIdleTimeout": 1800,
  "clientSessionMaxLifespan": 86400,

  "roles": {
    "realm": [
      {
        "name": "crm-user",
        "description": "KR-8 single operator role: full access to all CRM Lite operations"
      }
    ]
  },

  "users": [
    {
      "username": "ayilmaz",
      "enabled": true,
      "firstName": "Ali",
      "lastName": "Yilmaz",
      "email": "ayilmaz@crm-lite.local",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "crm-dev", "temporary": false }],
      "realmRoles": ["crm-user"],
      "requiredActions": []
    },
    {
      "username": "edemir",
      "enabled": true,
      "firstName": "Emre",
      "lastName": "Demir",
      "email": "edemir@crm-lite.local",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "crm-dev", "temporary": false }],
      "realmRoles": ["crm-user"],
      "requiredActions": []
    },
    {
      "username": "mkaya",
      "enabled": false,
      "firstName": "Mert",
      "lastName": "Kaya",
      "email": "mkaya@crm-lite.local",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "crm-dev", "temporary": false }],
      "realmRoles": ["crm-user"],
      "requiredActions": []
    }
  ],

  "clients": [
    {
      "clientId": "crm-bff",
      "name": "CRM Lite BFF (api-gateway)",
      "description": "OAuth2/OIDC Authorization Code + PKCE client for the api-gateway BFF. Public client: no secret is stored in this repository (ADR-006/007).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "rootUrl": "http://localhost:8080",
      "baseUrl": "http://localhost:8080",
      "redirectUris": ["http://localhost:8080/login/oauth2/code/keycloak"],
      "webOrigins": ["http://localhost:8080"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*"
      },
      "protocolMappers": [
        {
          "name": "crm-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "crm-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm-roles-in-id-token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ]
}
